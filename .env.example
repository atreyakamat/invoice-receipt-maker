# ==========================================
# Invoice & Receipt Maker - Environment Configuration
# ==========================================

# 1. Database Configuration (PostgreSQL)
# Used by Prisma ORM. Update credentials to match your docker-compose or managed DB.
DATABASE_URL="postgresql://admin:adminpassword@localhost:5432/invoice_db?schema=public"

# 2. Redis Configuration (BullMQ Background Jobs)
# Used by the OCR and notification worker queues.
REDIS_URL="redis://localhost:6379"

# 3. Server Configuration
PORT=3000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# 4. Authentication Secrets
# Required in production (the server refuses to start without them):
#   openssl rand -hex 32
JWT_SECRET=
REFRESH_SECRET=
# Docker only (docker-compose.production.yml): the database password
POSTGRES_PASSWORD=

# 5. AI & External Services
# The API key required for Nvidia AI services (LLM, Vision, OCR)
NVIDIA_API_KEY="your-nvidia-api-key-here"

# 6. Payment Processing (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..."

# 7. Email Dispatch (SendGrid or standard SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your-smtp-password"
FROM_EMAIL="noreply@yourdomain.com"

# 8. Inbound email (SendGrid Inbound Parse). Off unless set (32+ characters);
#    then use .../api/v1/inbound/email?token=<INBOUND_TOKEN> as the Parse URL.
INBOUND_TOKEN=

# 9. House of Stix control room address, so the app opens in its window
CONTROL_ROOM_ORIGIN=
