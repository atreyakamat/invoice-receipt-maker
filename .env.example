# Copy to .env (next to docker-compose.yml, or in server/ for local dev). Everything is optional for Docker.

# Port the app is published on (Docker)
APP_PORT=3000

# Database password used by docker-compose
POSTGRES_PASSWORD=invoicemaker

# Local development only (Docker sets this itself)
DATABASE_URL="postgresql://invoicemaker:invoicemaker@localhost:5432/invoicemaker?schema=public"

# AI extraction: any OpenAI-compatible endpoint. Leave AI_API_KEY empty for offline rule-based extraction.
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1         AI_MODEL=google/gemini-2.5-flash
#   Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AI_MODEL=gemini-2.5-flash
#   Ollama:     AI_BASE_URL=http://host.docker.internal:11434/v1  AI_MODEL=llama3.1  AI_API_KEY=ollama
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-2.5-flash

# Auth secrets. When empty, random secrets are generated once and kept in the data directory.
JWT_SECRET=
REFRESH_SECRET=

# Optional: SMTP for verification emails (logged to the console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
